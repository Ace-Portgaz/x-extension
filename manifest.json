{
  "manifest_version": 3,
  "name": "Stream Sniffer",
  "version": "2.0.0",
  "description": "Capture HLS and DASH manifests loaded by the current page.",
  "permissions": ["webRequest", "downloads", "storage", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Resource Sniffer",
    "default_popup": "popup.html"
  }
}
